---
/**
 * KiroSession — a static, replay-based mimic of the Kiro IDE chat window.
 *
 * Plays back a hand-curated demo session (JSON fixture) so docs readers get a
 * hands-on FEEL of what Kiro does — no live model, no CLI, no data processing.
 * Fully static: the fixture is inlined at build time and a small vanilla-JS
 * player streams the turns in the browser. No new dependencies.
 *
 *   import KiroSession from '../../../components/kiro-session/KiroSession.astro';
 *   <KiroSession session="estimate" />
 *
 * Add a new demo by dropping a JSON file in ./sessions/ matching the shape in
 * the existing fixtures (estimate.json, bugfix.json).
 */
import lifecycle from './sessions/lifecycle.json';
import review from './sessions/review.json';
import architecture from './sessions/architecture.json';

const SESSIONS: Record<string, any> = { lifecycle, review, architecture };

interface Props {
  /** Fixture id — filename under ./sessions/ without .json. */
  session?: string;
  /** Autoplay on load instead of waiting for the Run click. */
  autoplay?: boolean;
}

const { session = 'lifecycle', autoplay = false } = Astro.props;
const data = SESSIONS[session];
if (!data) {
  throw new Error(
    `KiroSession: unknown session "${session}". Known: ${Object.keys(SESSIONS).join(', ')}`
  );
}

// Unique id so multiple windows can coexist on one page.
const uid = `kiro-${session}-${Math.random().toString(36).slice(2, 8)}`;
const firstPrompt =
  data.turns.find((t: any) => t.role === 'user')?.blocks?.find((b: any) => b.type === 'text')
    ?.text ?? 'Ask a question or describe a task…';
---

<div class="kiro-session" id={uid} data-autoplay={autoplay ? '1' : '0'}>
  <script type="application/json" class="kiro-data" set:html={JSON.stringify(data)} />

  <!-- Title bar -->
  <div class="kiro-titlebar">
    <span class="kiro-tab"
      >{data.title}<span class="kiro-tab-x" aria-hidden="true">×</span></span
    >
    <span class="kiro-titlebar-actions" aria-hidden="true">
      <span class="kiro-icon">＋</span><span class="kiro-icon">☰</span>
    </span>
  </div>

  <!-- Dev-checkpoint stepper (populated + shown by JS when the session is stepped) -->
  <div class="kiro-stepper" hidden aria-label="Session checkpoints"></div>

  <!-- Message viewport (empty state lives here until Run) -->
  <div class="kiro-viewport" role="log" aria-live="polite">
    <div class="kiro-empty">
      <div class="kiro-ghost" aria-hidden="true">👻</div>
      <h3 class="kiro-empty-title">Let's build</h3>
      <p class="kiro-empty-sub">Plan, search, or build anything</p>
      <p class="kiro-empty-hint">
        {data.subtitle}
      </p>
    </div>
    <div class="kiro-messages" hidden></div>
  </div>

  <!-- Composer -->
  <div class="kiro-composer">
    <div class="kiro-input" title="Demo — recorded output, not live">{firstPrompt}</div>
    <div class="kiro-composer-row">
      <span class="kiro-composer-left">
        <span class="kiro-chip kiro-chip-mono">#</span>
        <span class="kiro-chip kiro-chip-mono">📎</span>
        <span class="kiro-chip">{data.model}</span>
        <span class="kiro-chip">{data.effort}</span>
      </span>
      <span class="kiro-composer-right">
        <span class="kiro-chip">{data.mode}</span>
        <span class="kiro-chip"
          >Autopilot <span class={`kiro-toggle ${data.autopilot ? 'on' : ''}`}></span></span
        >
        <button class="kiro-run" type="button" aria-label="Run demo">▶ Run demo</button>
      </span>
    </div>
  </div>

  <p class="kiro-disclaimer">{data.note}</p>
</div>

<script>
  // Player: streams a recorded Kiro session into the window. Vanilla JS, one
  // instance per .kiro-session so multiple demos coexist on a page.
  function initKiroSession(root: HTMLElement) {
    if (root.dataset.kiroInit === '1') return;
    root.dataset.kiroInit = '1';

    const dataEl = root.querySelector<HTMLScriptElement>('.kiro-data');
    const empty = root.querySelector<HTMLElement>('.kiro-empty');
    const messages = root.querySelector<HTMLElement>('.kiro-messages');
    const viewport = root.querySelector<HTMLElement>('.kiro-viewport');
    const runBtn = root.querySelector<HTMLButtonElement>('.kiro-run');
    const input = root.querySelector<HTMLElement>('.kiro-input');
    if (!dataEl || !empty || !messages || !viewport || !runBtn) return;

    let data: any;
    try {
      data = JSON.parse(dataEl.textContent || '{}');
    } catch {
      return;
    }

    let playing = false;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const scroll = () => {
      viewport.scrollTop = viewport.scrollHeight;
    };
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    // Minimal inline markdown: **bold**, `code`, *italic*, and line breaks.
    const md = (s: string) =>
      esc(s)
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`]+?)`/g, '<code>$1</code>')
        .replace(/(^|[^*])\*([^*\n]+?)\*/g, '$1<em>$2</em>')
        .replace(/\n{2,}/g, '<br><br>')
        .replace(/\n/g, '<br>');

    function bubble(role: string): HTMLElement {
      const el = document.createElement('div');
      el.className = `kiro-msg kiro-msg-${role}`;
      messages!.appendChild(el);
      return el;
    }

    async function typeText(target: HTMLElement, text: string) {
      const p = document.createElement('p');
      p.className = 'kiro-text';
      target.appendChild(p);
      // Stream word-by-word for a "generating" feel.
      const words = text.split(' ');
      for (let i = 0; i < words.length; i++) {
        p.innerHTML = md(words.slice(0, i + 1).join(' '));
        scroll();
        await sleep(18);
      }
    }

    function renderText(target: HTMLElement, text: string) {
      const p = document.createElement('p');
      p.className = 'kiro-text';
      p.innerHTML = md(text);
      target.appendChild(p);
      scroll();
    }

    function renderTool(target: HTMLElement, block: any) {
      const card = document.createElement('div');
      card.className = 'kiro-tool';
      card.innerHTML =
        `<div class="kiro-tool-head"><span class="kiro-tool-name">${esc(
          block.name || 'tool'
        )}</span><span class="kiro-tool-summary">${esc(block.summary || '')}</span></div>` +
        (block.detail
          ? `<pre class="kiro-tool-detail">${esc(block.detail)}</pre>`
          : '');
      target.appendChild(card);
      scroll();
    }

    function renderCode(target: HTMLElement, block: any) {
      const wrap = document.createElement('div');
      wrap.className = 'kiro-code';
      const head = block.lang
        ? `<div class="kiro-code-lang">${esc(block.lang)}</div>`
        : '';
      wrap.innerHTML = head + `<pre class="kiro-code-body">${esc(block.text || '')}</pre>`;
      target.appendChild(wrap);
      scroll();
    }

    function renderDiff(target: HTMLElement, block: any) {
      const wrap = document.createElement('div');
      wrap.className = 'kiro-diff';
      const head = block.file
        ? `<div class="kiro-diff-file">${esc(block.file)}</div>`
        : '';
      const lines = (block.hunks || [])
        .map((h: any) => {
          const cls =
            h.type === 'add' ? 'add' : h.type === 'del' ? 'del' : 'ctx';
          const sign = h.type === 'add' ? '+' : h.type === 'del' ? '-' : ' ';
          return `<div class="kiro-diff-line ${cls}">${esc(sign + ' ' + h.text)}</div>`;
        })
        .join('');
      wrap.innerHTML = head + `<div class="kiro-diff-body">${lines}</div>`;
      target.appendChild(wrap);
      scroll();
    }

    function renderEstimate(target: HTMLElement, block: any) {
      const wrap = document.createElement('div');
      wrap.className = 'kiro-estimate';
      const rows = (block.rows || [])
        .map(
          (r: any) =>
            `<tr><td>${esc(r.task)}</td><td class="kiro-est-size">${esc(
              r.size
            )}</td></tr>`
        )
        .join('');
      wrap.innerHTML =
        `<div class="kiro-est-head"><span class="kiro-est-likely">Most likely: ${esc(
          block.mostLikely || ''
        )}</span><span class="kiro-est-range">Range: ${esc(
          block.range || ''
        )}</span></div>` +
        `<table class="kiro-est-table"><tbody>${rows}</tbody></table>`;
      target.appendChild(wrap);
      scroll();
    }

    async function playTurn(turn: any) {
      const el = bubble(turn.role);
      if (turn.role === 'assistant') {
        const label = document.createElement('div');
        label.className = 'kiro-thinking';
        label.textContent = 'Kiro';
        el.appendChild(label);
      }
      for (const block of turn.blocks || []) {
        if (block.type === 'text') {
          if (turn.role === 'user') renderText(el, block.text);
          else await typeText(el, block.text);
        } else if (block.type === 'code') {
          renderCode(el, block);
          await sleep(220);
        } else if (block.type === 'tool') {
          renderTool(el, block);
          await sleep(320);
        } else if (block.type === 'diff') {
          renderDiff(el, block);
          await sleep(220);
        } else if (block.type === 'estimate') {
          renderEstimate(el, block);
          await sleep(220);
        }
        await sleep(120);
      }
    }

    // A checkpoint = a user turn plus the assistant turn(s) that answer it —
    // the point where the developer stepped back in during the real session.
    const turns = data.turns || [];
    const useSteps = !!data.stepped;
    const checkpoints: any[] = [];
    if (useSteps) {
      for (const turn of turns) {
        if (turn.role === 'user' || checkpoints.length === 0) {
          checkpoints.push({ stage: turn.stage || null, turns: [turn] });
        } else {
          checkpoints[checkpoints.length - 1].turns.push(turn);
        }
      }
    } else {
      checkpoints.push({ stage: null, turns });
    }
    const stepped = useSteps && checkpoints.length > 1;
    let current = 0; // index of the next checkpoint to play

    const stepper = root.querySelector<HTMLElement>('.kiro-stepper');
    if (stepped && stepper) {
      stepper.hidden = false;
      checkpoints.forEach((cp, i) => {
        const pill = document.createElement('span');
        pill.className = 'kiro-step';
        pill.textContent = `${i + 1}. ${cp.stage || 'Step ' + (i + 1)}`;
        stepper.appendChild(pill);
      });
    }
    function paintSteps() {
      if (!stepper) return;
      stepper.querySelectorAll('.kiro-step').forEach((el, i) => {
        el.classList.toggle('done', i < current);
        el.classList.toggle('active', i === current && playing);
      });
    }
    function nextLabel(): string {
      if (current >= checkpoints.length) return '↻ Replay';
      if (current === 0) return '▶ Run demo';
      if (!stepped) return '↻ Replay';
      const cp = checkpoints[current];
      return `Next: ${cp.stage || 'Step ' + (current + 1)} →`;
    }

    const PLACEHOLDER = 'Ask a question or describe a task…';
    function promptOf(cp: any): string {
      const u = (cp?.turns || []).find((t: any) => t.role === 'user');
      const b = (u?.blocks || []).find((x: any) => x.type === 'text');
      return b ? b.text : '';
    }
    function setInput(text: string) {
      if (!input) return;
      if (text) {
        input.textContent = text;
        input.classList.remove('placeholder');
      } else {
        input.textContent = PLACEHOLDER;
        input.classList.add('placeholder');
      }
    }
    // Seed the composer with the first prompt that's queued to "send".
    setInput(promptOf(checkpoints[0]));

    async function play() {
      if (playing) return;
      if (current >= checkpoints.length) {
        // Replay from the top.
        current = 0;
        messages!.innerHTML = '';
      }
      playing = true;
      runBtn!.disabled = true;
      runBtn!.textContent = '▶ Playing…';
      setInput(''); // the queued prompt has now been "sent"
      empty!.hidden = true;
      messages!.hidden = false;
      paintSteps();
      const cp = checkpoints[current];
      for (const turn of cp.turns) {
        await playTurn(turn);
        await sleep(180);
      }
      current++;
      playing = false;
      paintSteps();
      runBtn!.disabled = false;
      runBtn!.textContent = nextLabel();
      // Queue the next prompt in the composer (or reset to placeholder).
      setInput(current < checkpoints.length ? promptOf(checkpoints[current]) : '');
    }

    runBtn.addEventListener('click', play);
    if (root.dataset.autoplay === '1') {
      // Only autoplay when scrolled into view, to avoid burning it offscreen.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            play();
            io.disconnect();
          }
        }
      });
      io.observe(root);
    }
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>('.kiro-session')
      .forEach(initKiroSession);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<style>
  .kiro-session {
    --k-bg: #0e2a33;
    --k-bg-2: #0a2129;
    --k-border: #1c3d47;
    --k-text: #cfe3e8;
    --k-muted: #7fa2ad;
    --k-accent: #4fd1c5;
    --k-user: #12333d;
    --k-add: #143b2a;
    --k-add-text: #6ee7a8;
    --k-del: #40202a;
    --k-del-text: #f6a7b6;

    max-width: 640px;
    margin: 1.75rem auto;
    border: 1px solid var(--k-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--k-bg);
    color: var(--k-text);
    font-size: 0.9rem;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }

  .kiro-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--k-bg-2);
    border-bottom: 1px solid var(--k-border);
    padding: 0 0.35rem;
    height: 34px;
  }
  .kiro-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    height: 34px;
    background: var(--k-bg);
    border-right: 1px solid var(--k-border);
    font-size: 0.8rem;
    color: var(--k-text);
  }
  .kiro-tab-x {
    color: var(--k-muted);
  }
  .kiro-titlebar-actions {
    display: flex;
    gap: 0.65rem;
    padding-right: 0.5rem;
    color: var(--k-muted);
  }

  .kiro-stepper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.5rem 0.7rem;
    background: var(--k-bg-2);
    border-bottom: 1px solid var(--k-border);
  }
  .kiro-step {
    font-size: 0.68rem;
    color: var(--k-muted);
    background: var(--k-bg);
    border: 1px solid var(--k-border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .kiro-step.done {
    color: var(--k-add-text);
    border-color: #1e5a44;
  }
  .kiro-step.active {
    color: #06262b;
    background: var(--k-accent);
    border-color: var(--k-accent);
    font-weight: 600;
  }

  .kiro-viewport {
    min-height: 300px;
    max-height: 460px;
    overflow-y: auto;
    padding: 1rem 1.1rem;
  }

  .kiro-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 268px;
    gap: 0.15rem;
  }
  .kiro-ghost {
    font-size: 2.4rem;
    filter: grayscale(0.15);
    opacity: 0.92;
  }
  .kiro-empty-title {
    margin: 0.4rem 0 0;
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
  }
  .kiro-empty-sub {
    margin: 0;
    color: var(--k-muted);
  }
  .kiro-empty-hint {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    color: var(--k-muted);
    max-width: 34ch;
  }

  .kiro-messages {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .kiro-msg {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .kiro-msg-user {
    align-self: flex-end;
    max-width: 85%;
    background: var(--k-user);
    border: 1px solid var(--k-border);
    border-radius: 12px 12px 2px 12px;
    padding: 0.55rem 0.8rem;
  }
  .kiro-msg-assistant {
    align-self: flex-start;
    max-width: 96%;
  }
  .kiro-thinking {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--k-accent);
    font-weight: 600;
  }
  .kiro-text {
    margin: 0;
    line-height: 1.5;
  }
  .kiro-text code {
    background: var(--k-bg-2);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  .kiro-tool {
    border: 1px solid var(--k-border);
    border-radius: 8px;
    background: var(--k-bg-2);
    overflow: hidden;
  }
  .kiro-tool-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--k-border);
  }
  .kiro-tool-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: var(--k-accent);
  }
  .kiro-tool-summary {
    font-size: 0.78rem;
    color: var(--k-muted);
  }
  .kiro-tool-detail {
    margin: 0;
    padding: 0.5rem 0.6rem;
    font-size: 0.74rem;
    line-height: 1.45;
    white-space: pre-wrap;
    color: var(--k-text);
    overflow-x: auto;
  }

  .kiro-code {
    border: 1px solid var(--k-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--k-bg-2);
  }
  .kiro-code-lang {
    padding: 0.3rem 0.6rem;
    border-bottom: 1px solid var(--k-border);
    font-size: 0.72rem;
    color: var(--k-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .kiro-code-body {
    margin: 0;
    padding: 0.55rem 0.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    line-height: 1.5;
    white-space: pre-wrap;
    color: var(--k-text);
    overflow-x: auto;
  }

  .kiro-diff {
    border: 1px solid var(--k-border);
    border-radius: 8px;
    overflow: hidden;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
  }
  .kiro-diff-file {
    padding: 0.35rem 0.6rem;
    background: var(--k-bg-2);
    border-bottom: 1px solid var(--k-border);
    color: var(--k-muted);
  }
  .kiro-diff-line {
    padding: 0.1rem 0.6rem;
    white-space: pre-wrap;
  }
  .kiro-diff-line.add {
    background: var(--k-add);
    color: var(--k-add-text);
  }
  .kiro-diff-line.del {
    background: var(--k-del);
    color: var(--k-del-text);
  }
  .kiro-diff-line.ctx {
    color: var(--k-muted);
  }

  .kiro-estimate {
    border: 1px solid var(--k-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--k-bg-2);
  }
  .kiro-est-head {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--k-border);
    font-size: 0.78rem;
  }
  .kiro-est-likely {
    color: var(--k-accent);
    font-weight: 600;
  }
  .kiro-est-range {
    color: var(--k-muted);
  }
  .kiro-est-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    margin: 0;
  }
  .kiro-est-table td {
    padding: 0.3rem 0.6rem;
    border-top: 1px solid var(--k-border);
  }
  .kiro-est-size {
    text-align: right;
    color: var(--k-muted);
    white-space: nowrap;
  }

  .kiro-composer {
    border-top: 1px solid var(--k-border);
    background: var(--k-bg-2);
    padding: 0.6rem 0.7rem;
  }
  .kiro-input {
    background: var(--k-bg);
    border: 1px solid var(--k-border);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    color: var(--k-text);
    margin-bottom: 0.55rem;
    min-height: 1.2rem;
  }
  .kiro-input.placeholder {
    color: var(--k-muted);
  }
  .kiro-composer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .kiro-composer-left,
  .kiro-composer-right {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .kiro-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    color: var(--k-muted);
    background: var(--k-bg);
    border: 1px solid var(--k-border);
    border-radius: 6px;
    padding: 0.2rem 0.45rem;
  }
  .kiro-chip-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .kiro-toggle {
    width: 22px;
    height: 12px;
    border-radius: 6px;
    background: #2b4a54;
    position: relative;
    display: inline-block;
  }
  .kiro-toggle::after {
    content: '';
    position: absolute;
    top: 1px;
    left: 1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--k-muted);
    transition: transform 0.15s;
  }
  .kiro-toggle.on {
    background: var(--k-accent);
  }
  .kiro-toggle.on::after {
    transform: translateX(10px);
    background: #06262b;
  }
  .kiro-run {
    font-size: 0.76rem;
    font-weight: 600;
    color: #06262b;
    background: var(--k-accent);
